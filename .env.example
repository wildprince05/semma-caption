# Yelloverse Environment Variables

# Groq API Key (required - get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (defaults to qwen/qwen3.8-27b which supports Tanglish text + Vision)
GROQ_MODEL=qwen/qwen3.8-27b

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_PATH=./data/yelloverse.db

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
